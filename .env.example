# Copy into .local/app.env and fill private values; never commit the completed file.
HUTIAN_DATABASE_URL=postgresql://hutian_world_app:YOUR_PASSWORD@127.0.0.1:5432/hutian_world
HUTIAN_API_TOKEN=REPLACE_WITH_AT_LEAST_40_RANDOM_CHARACTERS
HUTIAN_CREATOR_ID=REPLACE_WITH_A_UUID
HUTIAN_API_PORT=3341
HUTIAN_API_URL=http://127.0.0.1:3341
# Optional local services for private chat; the member and project pages do not require them.
HUTIAN_CHAT_URL=http://127.0.0.1:3310
HUTIAN_MATRIX_URL=http://127.0.0.1:8008
